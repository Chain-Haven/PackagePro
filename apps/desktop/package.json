{
  "name": "@packagepro/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "pnpm run build && electron-builder",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist dist-electron"
  },
  "dependencies": {
    "@packagepro/shared": "workspace:*",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "tailwind-merge": "^2.6",
    "lucide-react": "^0.468",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "@vitejs/plugin-react": "^4",
    "electron": "^33",
    "electron-builder": "^25",
    "typescript": "^5.6",
    "vite": "^6",
    "vite-plugin-electron": "^0.28",
    "vite-plugin-electron-renderer": "^0.14",
    "tailwindcss": "^4",
    "@tailwindcss/vite": "^4",
    "postcss": "^8"
  },
  "build": {
    "appId": "io.packagepro.desktop",
    "productName": "PackagePro",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "PackagePro-${version}-win-x64.${ext}",
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
